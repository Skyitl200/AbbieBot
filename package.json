{
  "name": "studybot",
  "version": "2.1.0",
  "description": "Modular Ultimate Community Bot by Touchpoint Support",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "test:rules": "node --test tests/rules-embed.test.js",
    "test:study": "node --test tests/study.test.js tests/study-images.test.js tests/study-blood-vessels.test.js tests/study-lymphatic.test.js tests/study-respiratory.test.js tests/study-digestive.test.js tests/study-fluid-balance.test.js tests/study-reproductive.test.js tests/study-usage-limit.test.js tests/study-lecture-choices.test.js tests/study-skip.test.js tests/question-reports.test.js tests/study-ordering-prompts.test.js",
    "validate:study:images": "node scripts/validateStudyImages.js",
    "validate:study": "node scripts/validateStudyQuestions.js",
    "validate:study:complete": "node scripts/validateStudyQuestions.js --complete",
    "migrate": "node scripts/migrate.js apply",
    "migrate:check": "node scripts/migrate.js check",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:keys": "node scripts/migrate-keys.js",
    "migrate:keys:dry": "node scripts/migrate-keys.js --dry-run",
    "backup:db": "node scripts/backup.js",
    "restore:db": "node scripts/restore.js",
    "backup:drill": "node scripts/restore-drill.js",
    "test:microbemon": "node --test tests/microbemon.test.js",
    "test:discovery": "node --test tests/discovery.test.js"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.1",
    "axios": "^1.15.2",
    "discord.js": "^14.26.4",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "node-cron": "^4.2.1",
    "pg": "^8.11.3",
    "pngjs": "^7.0.0",
    "riffy": "1.0.12",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "undici": "^6.27.0"
  }
}
